generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  fullName          String     @map("full_name")
  subcontractorName String?    @map("subcontractor_name")
  businessName      String?    @default("Velocity Taxi Trucks") @map("business_name")
  rego              String?
  yardLocation      String?    @map("yard_location")
  role              Role       @default(DRIVER)
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  auditLogs         AuditLog[]
  runsheets         Runsheet[]

  @@map("users")
}

model Runsheet {
  id                    String        @id @default(uuid())
  driverId              String        @map("driver_id")
  shiftDate             DateTime      @map("shift_date") @db.Date
  odometerStart         Decimal       @map("odometer_start") @db.Decimal(10, 2)
  odometerFinish        Decimal?      @map("odometer_finish") @db.Decimal(10, 2)
  totalDistance         Decimal?      @map("total_distance") @db.Decimal(10, 2)
  originYard            String        @map("origin_yard")
  startTime             String        @map("start_time")
  endTime               String?       @map("end_time")
  depotEndLocation      String?       @map("depot_end_location")

  // Break 1
  break1StartTime       String?       @map("break_1_start_time")
  break1Duration        Int?          @default(15) @map("break_1_duration")
  break1EndTime         String?       @map("break_1_end_time")

  // Break 2
  break2StartTime       String?       @map("break_2_start_time")
  break2Duration        Int?          @default(30) @map("break_2_duration")
  break2EndTime         String?       @map("break_2_end_time")

  // Break 3
  break3StartTime       String?       @map("break_3_start_time")
  break3Duration        Int?          @default(15) @map("break_3_duration")
  break3EndTime         String?       @map("break_3_end_time")

  // Break 4
  break4StartTime       String?       @map("break_4_start_time")
  break4Duration        Int?          @default(15) @map("break_4_duration")
  break4EndTime         String?       @map("break_4_end_time")

  // Travel and Closure Timings
  firstArrivalTime      String?       @map("first_arrival_time")
  travelTimeDuration    String?       @map("travel_time_duration")
  finalDepartTime       String?       @map("final_depart_time")
  lastEndTime           String?       @map("last_end_time")
  returnTime            String?       @map("return_time")

  comments              String?
  signatureUrl          String?       @map("signature_url")
  status                ShiftStatus   @default(DRAFT)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  businessName          String?       @map("business_name")
  rego                  String?
  subcontractorName     String?       @map("subcontractor_name")
  yardLocation          String?       @map("yard_location")
  legs                  RunsheetLeg[]
  driver                User          @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, shiftDate])
  @@index([status])
  @@map("runsheets")
}

model RunsheetLeg {
  id                String   @id @default(uuid())
  runsheetId        String   @map("runsheet_id")
  legOrder          Int      @map("leg_order")
  type              LegType
  arrivalTime       String   @map("arrival_time")
  departureTime     String   @map("departure_time")
  authorisedPerson  String?  @map("authorised_person")
  itemCount         Int      @default(1) @map("item_count")
  itemDescription   String?  @map("item_description")
  tollUsed          Boolean  @default(false) @map("toll_used")
  tollAmount        Decimal? @default(0.00) @map("toll_amount") @db.Decimal(8, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  collectionCompany String?  @map("collection_company")
  collectionSuburb  String?  @map("collection_suburb")
  deliveryCompany   String?  @map("delivery_company")
  deliverySuburb    String?  @map("delivery_suburb")
  notes             String?
  tollAuthorizedBy  String?  @map("toll_authorized_by")
  runsheet          Runsheet @relation(fields: [runsheetId], references: [id], onDelete: Cascade)

  @@index([runsheetId])
  @@index([collectionCompany])
  @@index([deliveryCompany])
  @@map("runsheet_legs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  resource  String
  payload   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum Role {
  DRIVER
  ADMIN
}

enum ShiftStatus {
  DRAFT
  COMPLETED
}

enum LegType {
  PICKUP
  DELIVERY
}
